# 1. 先运行 lint-staged 自动修复暂存的文件
npx lint-staged

# 2. 自动修复前端格式并检查
echo ""
echo "🔍 检查前端代码规范..."
cd apps/web
npx prettier --write "src/**/*.{ts,tsx,js,jsx}" --log-level warn 2>&1
npx eslint --fix "src/**/*.{ts,tsx}" --quiet 2>&1
git add -u .
npx next lint 2>&1
FRONTEND_EXIT=$?
cd ../..

if [ $FRONTEND_EXIT -ne 0 ]; then
  echo ""
  echo "❌ 前端检查失败，请根据上方错误信息修复后再提交"
  exit 1
fi

# 3. 自动修复后端格式并检查
echo ""
echo "🔍 检查后端代码格式..."
apps/api/.venv/bin/python -m ruff format apps/api/ services/ 2>&1
apps/api/.venv/bin/python -m ruff check --fix apps/api/ services/ 2>&1
git add -u apps/api/ services/

# 修复后再检查是否还有无法自动修复的问题
apps/api/.venv/bin/python -m ruff check apps/api/ services/ 2>&1
BACKEND_LINT_EXIT=$?

if [ $BACKEND_LINT_EXIT -ne 0 ]; then
  echo ""
  echo "❌ 后端存在无法自动修复的代码规范问题，请手动修复"
  exit 1
fi

# 4. 类型检查（检测未导入的类型和类型错误）
echo ""
echo "🔍 检查后端类型注解..."
# --python-version 3.10: 允许新语法（为未来升级做准备）
# 只检查明显错误：未定义的名称、缺失导入等
apps/api/.venv/bin/python -m mypy apps/api/ services/ \
  --python-version 3.10 \
  --ignore-missing-imports \
  --no-strict-optional 2>&1 | grep -E "(error:|Error)" || true

MYPY_EXIT=${PIPESTATUS[0]}

if [ $MYPY_EXIT -ne 0 ]; then
  echo ""
  echo "❌ 发现类型注解错误，请修复后再提交"
  echo "💡 常见问题："
  echo "   - 缺少 typing 导入：from typing import List, Dict, Optional"
  echo "   - 使用了未定义的类型名称"
  exit 1
fi

echo ""
echo "✅ 所有检查通过"

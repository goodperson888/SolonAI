# 数据库配置（默认本地 SQLite 开发）
DATABASE_URL=sqlite+aiosqlite:///./solon_ai.db
SUPABASE_URL=
SUPABASE_KEY=

# Redis配置（本地 Docker Redis）
REDIS_URL=redis://localhost:6379

# Solana配置（Alchemy Devnet）
SOLANA_RPC_URL=https://solana-devnet.g.alchemy.com/v2/your_api_key
ALCHEMY_API_KEY=your_api_key
SOLON_DEMO_MODE=false

# AI模型配置（可选）
DOUBAO_API_KEY=
DOUBAO_API_URL=

# JWT配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 向量数据库（可选）
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

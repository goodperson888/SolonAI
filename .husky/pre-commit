# 1. 先运行 lint-staged 自动修复暂存的文件
npx lint-staged

# 2. 自动修复前端格式并检查
echo ""
echo "🔍 检查前端代码规范..."
cd apps/web
npx prettier --write "src/**/*.{ts,tsx,js,jsx}" --log-level warn 2>&1
npx eslint --fix "src/**/*.{ts,tsx}" --quiet 2>&1
git add -u .
npx next lint 2>&1
FRONTEND_EXIT=$?
cd ../..

if [ $FRONTEND_EXIT -ne 0 ]; then
  echo ""
  echo "❌ 前端检查失败，请根据上方错误信息修复后再提交"
  exit 1
fi

# 3. 自动修复后端格式并检查
echo ""
echo "🔍 检查后端代码格式..."
apps/api/.venv/bin/python -m ruff format apps/api/ services/ 2>&1
apps/api/.venv/bin/python -m ruff check --fix apps/api/ services/ 2>&1
git add -u apps/api/ services/

# 修复后再检查是否还有无法自动修复的问题
apps/api/.venv/bin/python -m ruff check apps/api/ services/ 2>&1
BACKEND_LINT_EXIT=$?

if [ $BACKEND_LINT_EXIT -ne 0 ]; then
  echo ""
  echo "❌ 后端存在无法自动修复的代码规范问题，请手动修复"
  exit 1
fi

echo ""
echo "✅ 所有检查通过"

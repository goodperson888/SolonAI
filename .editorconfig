.editorconfig 用于统一不同编辑器的基础格式设置
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript / JavaScript / JSON
[*.{ts,tsx,js,jsx,json,css,md}]
indent_size = 2

# Python
[*.py]
indent_size = 4
max_line_length = 100

# Markdown
[*.md]
trim_trailing_whitespace = false

# YAML
[*.{yml,yaml}]
indent_size = 2
